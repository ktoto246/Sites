@model DashboardViewModel
@{ ViewData["Title"] = "Обзор"; var role = Model.Role; var roleName = role == "admin" ? "администратора" : role == "mechanic" ? "механика" : "диспетчера"; }
<div class="page-heading animate-in"><div><span class="eyebrow accent">СРЕДА, @DateTime.Today.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU")).ToUpper()</span><h1>Добрый день, @roleName <span class="wave">✦</span></h1><p>Состояние парка и рабочие задачи на сегодня.</p></div><div class="heading-actions"><a class="btn btn-primary" asp-controller="Requests" asp-action="Create"><span>＋</span> Новая заявка</a></div></div>
<div class="insight-banner animate-in"><div class="insight-icon">✧</div><div><strong>Парк работает стабильно</strong><p>4 из 5 единиц техники доступны. Есть 2 задачи, требующие внимания сегодня.</p></div><a asp-controller="Requests" asp-action="Index">Посмотреть задачи <span>→</span></a></div>
<div class="metric-grid">
  <div class="metric-card metric-blue animate-in"><div class="metric-top"><span>Техника в парке</span><span class="metric-icon">▣</span></div><div class="metric-value">@Model.EquipmentCount</div><div class="metric-foot"><span class="trend trend-up">↗ 8.2%</span><span>к прошлому месяцу</span></div></div>
  <div class="metric-card metric-orange animate-in"><div class="metric-top"><span>Активные заявки</span><span class="metric-icon">✦</span></div><div class="metric-value">@Model.ActiveRequests</div><div class="metric-foot"><span class="trend trend-warn">• 2 требуют внимания</span></div></div>
  <div class="metric-card metric-green animate-in"><div class="metric-top"><span>ТО в ближайшие 14 дней</span><span class="metric-icon">◷</span></div><div class="metric-value">@Model.UpcomingMaintenance</div><div class="metric-foot"><span class="trend trend-up">↗ по графику</span></div></div>
  <div class="metric-card metric-violet animate-in"><div class="metric-top"><span>Расходы на детали</span><span class="metric-icon">₽</span></div><div class="metric-value">@Model.MonthPurchases.ToString("N0") <small>₽</small></div><div class="metric-foot"><span class="trend trend-up">↗ 12.4%</span><span>за текущий месяц</span></div></div>
</div>
<div class="dashboard-grid">
 <section class="panel requests-panel animate-in"><div class="panel-heading"><div><span class="eyebrow">ОПЕРАТИВНО</span><h2>Последние заявки</h2></div><a class="text-link" asp-controller="Requests" asp-action="Index">Все заявки <span>→</span></a></div><div class="request-list">@foreach (var request in Model.RecentRequests) { <div class="request-row"><div class="request-priority priority-@(request.Priority == "Высокий" ? "high" : request.Priority == "Средний" ? "medium" : "low")"></div><div class="request-main"><strong>@request.Title</strong><small>@request.Equipment?.InventoryNumber · @request.Equipment?.Name @request.Equipment?.Brand</small></div><span class="status status-@request.Status.Replace(" ", "-")">@request.Status</span><div class="request-date">@request.ReportedAt.ToString("dd.MM")</div></div>}</div></section>
 <section class="panel plans-panel animate-in"><div class="panel-heading"><div><span class="eyebrow">РАСПИСАНИЕ</span><h2>Ближайшее ТО</h2></div><a class="text-link" asp-controller="Equipment" asp-action="Index">Календарь <span>→</span></a></div><div class="plan-list">@foreach (var plan in Model.UpcomingPlans) { <div class="plan-row"><div class="plan-date"><strong>@plan.DueDate.ToString("dd")</strong><small>@plan.DueDate.ToString("MMM", new System.Globalization.CultureInfo("ru-RU"))</small></div><div><strong>@plan.Title</strong><small>@plan.Equipment?.InventoryNumber · @plan.Mechanic?.FullName.Split(' ')[0]</small></div><span class="plan-arrow">→</span></div>}</div></section>
</div>
<section class="panel fleet-panel animate-in"><div class="panel-heading"><div><span class="eyebrow">МОЙ ПАРК</span><h2>Состояние техники</h2></div><a class="text-link" asp-controller="Equipment" asp-action="Index">Открыть парк <span>→</span></a></div><div class="fleet-grid">@foreach (var equipment in Model.Equipment) { var stateClass = equipment.Status == "В ремонте" ? "broken" : equipment.Status == "ТО скоро" ? "service" : "ready"; <a class="fleet-card" asp-controller="Equipment" asp-action="Details" asp-route-id="@equipment.Id"><div class="fleet-info"><div><strong>@equipment.Brand @equipment.Model</strong><small>@equipment.InventoryNumber · @equipment.Hours.ToString("N0") м/ч</small></div><span class="state-dot @stateClass"></span></div></a> }</div></section>



