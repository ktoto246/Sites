@model List<Part>
@{ ViewData["Title"] = "Склад и закупки"; var purchases = (List<Purchase>)ViewBag.Purchases; var employees = (List<Employee>)ViewBag.Employees; }
<div class="page-heading animate-in"><div><span class="eyebrow accent">МАТЕРИАЛЬНОЕ ОБЕСПЕЧЕНИЕ</span><h1>Склад и закупки</h1><p>Остатки запчастей, поставщики и история поступлений.</p></div><div class="heading-actions"><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#purchaseModal">＋ Оформить закупку</button></div></div>
<div class="warehouse-summary"><div class="warehouse-stat animate-in"><span class="warehouse-stat-icon green">▤</span><div><strong>@Model.Count</strong><small>позиций на складе</small></div></div><div class="warehouse-stat animate-in"><span class="warehouse-stat-icon orange">!</span><div><strong>@Model.Count(x => x.StockQuantity <= x.MinStock)</strong><small>нужно пополнить</small></div></div><div class="warehouse-stat animate-in"><span class="warehouse-stat-icon blue">₽</span><div><strong>@purchases.Sum(x => x.Total).ToString("N0") ₽</strong><small>поступления за период</small></div></div></div>
<div class="toolbar animate-in"><form method="get" class="search-box"><span>⌕</span><input name="search" value="@ViewBag.Search" placeholder="Поиск по названию или артикулу..." /></form></div>
<div class="dashboard-grid warehouse-grid"><section class="panel table-panel animate-in"><div class="panel-heading"><div><span class="eyebrow">ОСТАТКИ</span><h2>Запчасти на складе</h2></div></div><table class="data-table compact-table"><thead><tr><th>Наименование</th><th>Артикул</th><th>Остаток</th><th>Минимум</th><th>Состояние</th></tr></thead><tbody>@foreach (var item in Model) { var low = item.StockQuantity <= item.MinStock; <tr><td><strong>@item.Name</strong><small class="table-sub">@item.Unit</small></td><td class="mono">@item.Article</td><td><strong>@item.StockQuantity</strong> @item.Unit</td><td>@item.MinStock</td><td><span class="stock-state @(low ? "low" : "ok")"><span></span>@(low ? "Низкий запас" : "В норме")</span></td></tr> }</tbody></table></section><section class="panel animate-in"><div class="panel-heading"><div><span class="eyebrow">ДОКУМЕНТЫ</span><h2>Последние закупки</h2></div></div><div class="purchase-list">@foreach (var item in purchases.Take(5)) { <div class="purchase-row"><div class="purchase-icon">▤</div><div><strong>@item.Part?.Name</strong><small>@item.Supplier · @item.ReceiptNumber</small></div><div class="purchase-amount">+@item.Quantity<br /><a asp-action="ReceiptPdf" asp-route-id="@item.Id">Чек PDF</a></div></div> }</div></section></div>
<div class="modal fade" id="purchaseModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content custom-modal"><div class="modal-header"><div><span class="eyebrow accent">СКЛАД</span><h2>Новая закупка</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form asp-action="Purchase" method="post"><div class="modal-body"><div class="form-field"><label>Запчасть</label><select name="PartId" required><option value="">Выберите позицию</option>@foreach (var item in Model) { <option value="@item.Id">@item.Name (@item.StockQuantity @item.Unit)</option> }</select></div><div class="form-grid"><div class="form-field"><label>Количество</label><input name="Quantity" type="number" min="1" required /></div><div class="form-field"><label>Цена за единицу, ₽</label><input name="UnitPrice" type="number" step="0.01" min="0" required /></div></div><div class="form-field"><label>Поставщик</label><input name="Supplier" placeholder="Название организации" required /></div><div class="form-grid"><div class="form-field"><label>Чек / накладная</label><input name="ReceiptNumber" placeholder="Например, ПН-1052" required /></div><div class="form-field"><label>Кто оформил</label><select name="PurchasedById">@foreach (var item in employees) { <option value="@item.Id">@item.FullName</option> }</select></div></div></div><div class="modal-footer"><button class="btn btn-ghost" type="button" data-bs-dismiss="modal">Отмена</button><button class="btn btn-primary" type="submit">Сохранить и скачать чек</button></div></form></div></div></div>
