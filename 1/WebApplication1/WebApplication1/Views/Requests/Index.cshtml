@model List<MaintenanceRequest>
@{ ViewData["Title"] = "Заявки"; var role = ViewData["Role"]?.ToString() ?? "dispatcher"; }
<div class="page-heading animate-in"><div><span class="eyebrow accent">ОПЕРАТИВНЫЙ ЖУРНАЛ</span><h1>Заявки на ремонт</h1><p>Контроль неисправностей, сроков и ответственных специалистов.</p></div>@if (role != "mechanic") { <div class="heading-actions"><a class="btn btn-primary" asp-action="Create">＋ Новая заявка</a></div> }</div>
<div class="toolbar animate-in"><form method="get" class="search-box"><span>⌕</span><input name="search" value="@ViewBag.Search" placeholder="Поиск по заявке или технике..." /></form><div class="request-tabs"><a class="@(string.IsNullOrEmpty(ViewBag.Status) ? "active" : "")">Все <b>@Model.Count</b></a><a class="@(ViewBag.Status == "Новая" ? "active" : "")" asp-route-status="Новая">Новые</a><a class="@(ViewBag.Status == "В работе" ? "active" : "")" asp-route-status="В работе">В работе</a><a class="@(ViewBag.Status == "Ожидает запчасти" ? "active" : "")" asp-route-status="Ожидает запчасти">Ожидают детали</a><a class="@(ViewBag.Status == "Завершена" ? "active" : "")" asp-route-status="Завершена">Завершённые</a></div></div>
<div class="panel table-panel animate-in"><table class="data-table request-table"><thead><tr><th>Заявка</th><th>Техника</th><th>Приоритет</th><th>Ответственный</th><th>Дата</th><th>Статус</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><div class="request-cell"><span class="request-id">#@item.Id.ToString("000")</span><span><a class="request-title-link" asp-action="Details" asp-route-id="@item.Id">@item.Title</a><small>@item.Description</small></span></div></td><td><strong>@item.Equipment?.Brand @item.Equipment?.Model</strong><small class="table-sub">@item.Equipment?.InventoryNumber</small></td><td><span class="priority-label priority-@(item.Priority == "Высокий" ? "high" : item.Priority == "Средний" ? "medium" : "low")">● @item.Priority</span></td><td>@(item.Mechanic?.FullName ?? "Не назначен")</td><td>@item.ReportedAt.ToString("dd.MM.yy")</td><td><span class="status status-@item.Status.Replace(" ", "-")">@item.Status</span></td><td><a class="row-action" asp-action="Details" asp-route-id="@item.Id">Открыть →</a></td></tr> }</tbody></table></div>
