@model MaintenanceRequest
@{ ViewData["Title"] = "Новая заявка"; var role = ViewData["Role"]?.ToString() ?? "dispatcher"; var equipment = (List<Equipment>)ViewBag.Equipment; var employees = (List<Employee>)ViewBag.Employees; var mechanics = (List<Employee>)ViewBag.Mechanics; }
<div class="back-link"><a asp-action="Index">← К списку заявок</a></div><div class="page-heading compact animate-in"><div><span class="eyebrow accent">РЕГИСТРАЦИЯ НЕИСПРАВНОСТИ</span><h1>Новая заявка</h1><p>Заполните основные сведения — исполнитель и статус могут быть изменены позже.</p></div></div>
<form asp-action="Create" method="post" class="form-layout animate-in"><div class="panel form-panel"><div class="form-section"><h2>Что произошло?</h2><div class="form-grid"><div class="form-field full"><label asp-for="Title">Краткое название проблемы</label><input asp-for="Title" placeholder="Например: подтекает гидравлика" required /></div><div class="form-field full"><label asp-for="Description">Описание неисправности</label><textarea asp-for="Description" rows="4" placeholder="Опишите симптомы, при каких условиях проявилась проблема..."></textarea></div></div></div><div class="form-section"><h2>Привязка и планирование</h2><div class="form-grid"><div class="form-field"><label asp-for="EquipmentId">Техника</label><select asp-for="EquipmentId" required><option value="">Выберите технику</option>@foreach (var item in equipment) { <option value="@item.Id">@item.InventoryNumber — @item.Brand @item.Model</option> }</select></div><div class="form-field"><label asp-for="ReporterId">Сообщил о поломке</label><select asp-for="ReporterId"><option value="">Выберите тракториста</option>@foreach (var item in employees) { <option value="@item.Id">@item.FullName</option> }</select></div><div class="form-field"><label asp-for="MechanicId">Назначить механика</label><select asp-for="MechanicId"><option value="">Пока не назначать</option>@foreach (var item in mechanics) { <option value="@item.Id">@item.FullName</option> }</select></div><div class="form-field"><label asp-for="Priority">Приоритет</label><select asp-for="Priority"><option>Низкий</option><option selected>Средний</option><option>Высокий</option></select></div><div class="form-field"><label asp-for="ScheduledFor">Плановая дата</label><input asp-for="ScheduledFor" type="date" /></div></div></div><div class="form-actions"><a class="btn btn-ghost" asp-action="Index">Отмена</a><button class="btn btn-primary" type="submit">Создать заявку <span>→</span></button></div></div><aside class="form-aside"><div class="aside-note"><span>✦</span><strong>Подсказка диспетчеру</strong><p>После создания заявки механик увидит её в своём рабочем списке. Если нужны запчасти, переведите статус в «Ожидает запчасти».</p></div></aside></form>

