@model RequestDetailsViewModel
@{ ViewData["Title"] = "Карточка заявки"; var role = ViewData["Role"]?.ToString() ?? "dispatcher"; var request = Model.Request; var mechanics = (List<Employee>)ViewBag.Mechanics; }
<div class="back-link"><a asp-action="Index">← К журналу заявок</a></div><div class="detail-hero animate-in"><div class="machine-hero">Заявка</div><div><span class="eyebrow accent">ЗАЯВКА #@request.Id.ToString("000")</span><h1>@request.Title</h1><p>@request.Equipment?.InventoryNumber · @request.Equipment?.Brand @request.Equipment?.Model · сообщено @request.Reporter?.FullName</p></div><span class="status status-@request.Status.Replace(" ", "-")">@request.Status</span></div>
<div class="request-details-grid"><section class="panel animate-in"><div class="panel-heading"><div><span class="eyebrow">ОПИСАНИЕ</span><h2>Неисправность и выполнение</h2></div><span class="priority-label priority-@(request.Priority == "Высокий" ? "high" : request.Priority == "Средний" ? "medium" : "low")">● @request.Priority</span></div><div class="description-block"><strong>Описание от диспетчера</strong><p>@request.Description</p></div><div class="assignment-grid"><div><span>Ответственный механик</span><strong>@(request.Mechanic?.FullName ?? "Не назначен")</strong></div><div><span>Плановая дата</span><strong>@(request.ScheduledFor?.ToString("dd.MM.yyyy") ?? "Не установлена")</strong></div><div><span>Дата завершения</span><strong>@(request.CompletedAt?.ToString("dd.MM.yyyy") ?? "—")</strong></div></div><div class="description-block work-result"><strong>Результат работы</strong><p>@(string.IsNullOrWhiteSpace(request.WorkPerformed) ? "Механик ещё не добавил отчёт о выполненной работе." : request.WorkPerformed)</p></div></section><section class="panel animate-in"><div class="panel-heading"><div><span class="eyebrow">МАТЕРИАЛЫ</span><h2>Использованные детали</h2></div></div>@if (request.WorkParts.Any()) { <div class="parts-used">@foreach (var part in request.WorkParts) { <div><span class="purchase-icon">▤</span><strong>@part.Part?.Name</strong><small>@part.Quantity @part.Part?.Unit</small></div> }</div> } else { <div class="empty-state"><span>▤</span><p>Детали пока не списывались.</p></div> } @if (request.Status == "Завершена") { <a class="btn btn-ghost print-button" asp-action="WorkReportPdf" asp-route-id="@request.Id">⇩ Скачать карточку PDF</a> }</section></div>
@if ((role == "dispatcher" || role == "admin") && request.Status != "Завершена") { <form asp-action="Assign" method="post" class="panel work-form animate-in"><input type="hidden" name="id" value="@request.Id" /><div class="panel-heading"><div><span class="eyebrow">ДИСПЕТЧЕРСКАЯ</span><h2>Назначить исполнителя</h2></div></div><div class="form-inline"><select name="mechanicId" required><option value="">Выберите механика</option>@foreach (var mechanic in mechanics) { <option value="@mechanic.Id" selected="@(mechanic.Id == request.MechanicId)">@mechanic.FullName</option> }</select><button class="btn btn-primary" type="submit">Назначить механика</button></div></form> }
@if (role == "mechanic" && request.Status != "Завершена") { @if (request.MechanicId != ViewContext.HttpContext.Session.GetInt32("EmployeeId")) { <form asp-action="TakeToWork" method="post" class="take-work-form"><input type="hidden" name="id" value="@request.Id" /><button class="btn btn-primary" type="submit">Взять заявку в работу</button></form> } else { <form asp-action="CompleteWork" method="post" class="panel work-form animate-in"><input type="hidden" name="id" value="@request.Id" /><div class="panel-heading"><div><span class="eyebrow">РАБОЧЕЕ МЕСТО МЕХАНИКА</span><h2>Зафиксировать выполнение</h2></div></div><div class="form-grid"><div class="form-field full"><label>Что выполнено</label><textarea name="workPerformed" rows="3" required>@request.WorkPerformed</textarea></div><div class="form-field"><label>Статус заявки</label><select name="status"><option selected="@(request.Status == "В работе")">В работе</option><option selected="@(request.Status == "Ожидает запчасти")">Ожидает запчасти</option><option selected="@(request.Status == "Завершена")">Завершена</option></select></div><div class="form-field"><label>Использованная деталь</label><select name="partId"><option value="">Не списывать</option>@foreach (var part in Model.AvailableParts) { <option value="@part.Id">@part.Name — @part.StockQuantity @part.Unit</option> }</select></div><div class="form-field"><label>Количество</label><input name="partQuantity" type="number" min="1" value="1" /></div></div><div class="form-actions"><button class="btn btn-primary" type="submit">Сохранить результат</button></div></form> } }
