@model List<Employee>
@{ ViewData["Title"] = "Сотрудники"; }
<div class="page-heading animate-in"><div><span class="eyebrow accent">АДМИНИСТРИРОВАНИЕ</span><h1>Сотрудники</h1><p>Учётные записи, должности и состояние доступа.</p></div><div class="heading-actions"><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#employeeModal">＋ Добавить сотрудника</button></div></div>
<div class="toolbar animate-in"><form method="get" class="search-box"><span>⌕</span><input name="search" value="@ViewBag.Search" placeholder="Поиск по ФИО, должности или логину..." /></form></div>
@if (TempData["Error"] is string error) { <div class="form-message error-message">@error</div> }<div class="panel table-panel animate-in"><table class="data-table"><thead><tr><th>Сотрудник</th><th>Должность</th><th>Роль</th><th>Логин</th><th>Пароль</th><th>Телефон</th><th>Доступ</th><th></th></tr></thead><tbody>@foreach (var item in Model) { var roleName = item.Role switch { "admin" => "Администратор", "dispatcher" => "Диспетчер", "mechanic" => "Механик", _ => "Тракторист" }; <tr><td><div class="table-entity"><span class="avatar avatar-@(item.Role == "admin" ? "admin" : item.Role == "mechanic" ? "mechanic" : "dispatcher")">@string.Concat(item.FullName.Split(' ').Take(2).Select(x => x[0]))</span><span><strong>@item.FullName</strong><small>@item.Position</small></span></div></td><td>@item.Position</td><td><span class="role-badge @item.Role">@roleName</span></td><td class="mono">@(string.IsNullOrWhiteSpace(item.Login) ? "—" : item.Login)</td><td class="mono">@(string.IsNullOrWhiteSpace(item.Password) ? "—" : item.Password)</td><td>@item.Phone</td><td><span class="stock-state @(item.IsActive ? "ok" : "low")"><span></span>@(item.IsActive ? "Активен" : "Отключён")</span></td><td><form asp-action="ToggleActive" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="table-action" type="submit">@(item.IsActive ? "Уволить" : "Восстановить")</button></form></td></tr> }</tbody></table></div>
<div class="modal fade" id="employeeModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content custom-modal"><div class="modal-header"><div><span class="eyebrow accent">СОТРУДНИКИ</span><h2>Новый сотрудник</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form asp-action="Create" method="post"><div class="modal-body"><div class="form-field"><label>ФИО</label><input name="FullName" required /></div><div class="form-grid"><div class="form-field"><label>Должность</label><input name="Position" required /></div><div class="form-field"><label>Телефон</label><input name="Phone" /></div></div><div class="form-field"><label>Роль</label><select name="Role"><option value="dispatcher">Диспетчер</option><option value="mechanic">Механик</option><option value="driver">Тракторист</option><option value="admin">Администратор</option></select></div><div class="form-grid"><div class="form-field"><label>Логин</label><input name="Login" required /></div><div class="form-field"><label>Пароль</label><input name="Password" type="password" required /></div></div></div><div class="modal-footer"><button class="btn btn-ghost" type="button" data-bs-dismiss="modal">Отмена</button><button class="btn btn-primary" type="submit">Добавить сотрудника</button></div></form></div></div></div>


