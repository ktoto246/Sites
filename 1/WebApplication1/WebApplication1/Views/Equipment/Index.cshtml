@model List<Equipment>
@{ ViewData["Title"] = "Техника"; var role = ViewData["Role"]?.ToString() ?? "dispatcher"; }
<div class="page-heading animate-in"><div><span class="eyebrow accent">ПАРК ПРЕДПРИЯТИЯ</span><h1>Сельхозтехника</h1><p>Единый реестр машин и навесного оборудования.</p></div><div class="heading-actions"><a class="btn btn-primary" asp-controller="Requests" asp-action="Create">＋ Заявка на ремонт</a></div></div>
<div class="toolbar animate-in"><form method="get" class="search-box"><input type="hidden" name="role" value="@role" /><span>⌕</span><input name="search" value="@ViewBag.Search" placeholder="Поиск по названию или инвентарному номеру..." /></form><div class="filter-pills"><a class="filter-pill @(string.IsNullOrEmpty(ViewBag.Status) ? "selected" : "")">Все <b>@Model.Count</b></a>@foreach (var item in (List<string>)ViewBag.Statuses) { <a class="filter-pill @(ViewBag.Status == item ? "selected" : "")" asp-route-status="@item">@item</a> }</div></div>
<div class="panel table-panel animate-in"><table class="data-table"><thead><tr><th>Техника</th><th>Инв. номер</th><th>Состояние</th><th>Моточасы</th><th>Закреплённый тракторист</th><th>Локация</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><a class="table-entity" asp-action="Details" asp-route-id="@item.Id"><span><strong>@item.Brand @item.Model</strong><small>@item.Name · @item.Year г.</small></span></a></td><td><span class="mono">@item.InventoryNumber</span></td><td><span class="status status-@item.Status.Replace(" ", "-")">@item.Status</span></td><td><strong>@item.Hours.ToString("N0")</strong> м/ч</td><td>@(item.AssignedDriver?.FullName ?? "Не закреплён")</td><td>@item.Location</td><td><a class="row-action" asp-action="Details" asp-route-id="@item.Id">→</a></td></tr> }</tbody></table></div>


