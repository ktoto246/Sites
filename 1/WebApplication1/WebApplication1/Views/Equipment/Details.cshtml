@model EquipmentDetailsViewModel
@{ ViewData["Title"] = "Карточка техники"; var role = ViewData["Role"]?.ToString() ?? ""; var drivers = (List<Employee>)ViewBag.Drivers; var equipment = Model.Equipment; }
<div class="back-link"><a asp-action="Index">← Вернуться к парку</a></div>
<div class="detail-hero animate-in"><div><span class="eyebrow accent">@equipment.InventoryNumber</span><h1>@equipment.Brand @equipment.Model</h1><p>@equipment.Name · @equipment.Year год выпуска · @equipment.Location</p></div><span class="status status-@equipment.Status.Replace(" ", "-")">@equipment.Status</span></div>
<div class="detail-stats"><div><span>Моточасы</span><strong>@equipment.Hours.ToString("N0")</strong><small>м/ч</small></div><div><span>Тракторист</span><strong>@(equipment.AssignedDriver?.FullName.Split(' ')[0] ?? "—")</strong><small>закреплён</small></div><div><span>Заявок</span><strong>@Model.Requests.Count</strong><small>за всё время</small></div><div><span>Плановое ТО</span><strong>@(Model.Plans.FirstOrDefault()?.DueDate.ToString("dd.MM") ?? "—")</strong><small>ближайшая дата</small></div></div>
@if (equipment.Status == "Списана") { <div class="writeoff-note"><strong>Техника списана @equipment.WriteOffDate?.ToString("dd.MM.yyyy")</strong><span>@(string.IsNullOrWhiteSpace(equipment.WriteOffReason) ? "Причина не указана" : equipment.WriteOffReason)</span></div> } else { @if (role is "admin" or "dispatcher") { <section class="panel equipment-actions animate-in"><div><span class="eyebrow">ЗАКРЕПЛЕНИЕ ТЕХНИКИ</span><h2>Тракторист</h2><p>При увольнении тракториста закрепление снимается автоматически.</p></div><form asp-action="UpdateAssignment" method="post" class="form-inline"><input type="hidden" name="id" value="@equipment.Id" /><select name="assignedDriverId"><option value="">Не закреплён</option>@foreach (var driver in drivers) { <option value="@driver.Id" selected="@(driver.Id == equipment.AssignedDriverId)">@driver.FullName</option> }</select><button class="btn btn-primary" type="submit">Сохранить</button></form></section> } @if (role == "admin") { <section class="panel writeoff-panel animate-in"><div><span class="eyebrow">СПИСАНИЕ</span><h2>Списать технику</h2><p>Запись сохранится в истории, но техника не будет доступна для новых заявок и закреплений.</p></div><form asp-action="WriteOff" method="post" class="form-inline"><input type="hidden" name="id" value="@equipment.Id" /><input name="reason" placeholder="Причина списания" required /><button class="btn btn-danger" type="submit">Списать технику</button></form></section> } }
<div class="dashboard-grid"><section class="panel animate-in"><div class="panel-heading"><div><span class="eyebrow">ИСТОРИЯ</span><h2>Работы и ремонты</h2></div></div><div class="timeline">@foreach (var request in Model.Requests) { <div class="timeline-item"><span class="timeline-dot"></span><div><small>@request.ReportedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU")) · @request.Mechanic?.FullName</small><strong>@request.Title</strong><p>@(request.WorkPerformed ?? request.Description)</p></div><span class="status status-@request.Status.Replace(" ", "-")">@request.Status</span></div>}</div></section><section class="panel animate-in"><div class="panel-heading"><div><span class="eyebrow">ПЛАНИРОВАНИЕ</span><h2>Предстоящие работы</h2></div></div><div class="plan-list">@foreach (var plan in Model.Plans) { <div class="plan-row"><div class="plan-date"><strong>@plan.DueDate.ToString("dd")</strong><small>@plan.DueDate.ToString("MMM", new System.Globalization.CultureInfo("ru-RU"))</small></div><div><strong>@plan.Title</strong><small>@plan.Mechanic?.FullName</small></div></div>}</div></section></div>
