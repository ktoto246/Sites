@{
    var role = ViewData["Role"]?.ToString() ?? "";
    var roleLabel = role switch { "admin" => "Администратор", "mechanic" => "Механик", "dispatcher" => "Диспетчер", _ => "Сотрудник" };
    var activeEmployee = ViewData["ActiveEmployeeName"]?.ToString() ?? "Сотрудник";
}
<!DOCTYPE html>
<html lang="ru">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] — АгроКонтроль</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><div class="app-shell"><aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><span></span><span></span><span></span></span><span><strong>Агро</strong>Контроль<small>техобслуживание</small></span></a><nav class="main-nav"><span class="nav-caption">Рабочее пространство</span><a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><span class="nav-icon">⌂</span>Обзор</a><a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Equipment" ? "active" : "")" asp-controller="Equipment" asp-action="Index"><span class="nav-icon">▣</span>Техника</a><a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Requests" ? "active" : "")" asp-controller="Requests" asp-action="Index"><span class="nav-icon">✦</span>Заявки</a>@if (role != "mechanic") { <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Warehouse" ? "active" : "")" asp-controller="Warehouse" asp-action="Index"><span class="nav-icon">▤</span>Склад и закупки</a><a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index"><span class="nav-icon">◒</span>Отчёты</a> }@if (role == "admin") { <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Employees" ? "active" : "")" asp-controller="Employees" asp-action="Index"><span class="nav-icon">♙</span>Сотрудники</a> }</nav><div class="sidebar-bottom"><div class="active-user"><span class="avatar avatar-@role">@string.Concat(activeEmployee.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0]))</span><div><strong>@activeEmployee</strong><small>@roleLabel</small></div></div><form asp-controller="Account" asp-action="Logout" method="post"><button class="logout-button" type="submit">Выйти из системы <span>→</span></button></form></div></aside><main class="main-content"><header class="topbar"><div class="breadcrumbs">АгроКонтроль <span>/</span> @ViewData["Title"]</div></header><div class="content-wrap">@RenderBody()</div></main></div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>

