@model ReportsViewModel
@{
    ViewData["Title"] = "Отчёты и аналитика";
    var maxStatus = Math.Max(Model.Statuses.Select(x => x.Count).DefaultIfEmpty(1).Max(), 1);
    var maxEquipment = Math.Max(Model.EquipmentWorkload.Select(x => x.Count).DefaultIfEmpty(1).Max(), 1);
    var maxDaily = Math.Max(Model.Monthly.Select(x => x.Count).DefaultIfEmpty(1).Max(), 1);
    var periodText = $"{Model.DateFrom:dd.MM.yyyy} - {Model.DateTo:dd.MM.yyyy}";
}
<div class="page-heading animate-in">
    <div><span class="eyebrow accent">АНАЛИТИКА ПРЕДПРИЯТИЯ</span><h1>Отчёты и показатели</h1><p>Сводная картина по ремонтам, ТО и расходам на запчасти.</p></div>
    <div class="heading-actions"><a class="btn btn-primary" asp-action="ExportPdf" asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")">⇩ Скачать PDF-отчёт</a></div>
</div>
<form method="get" class="panel report-period-filter animate-in">
    <div class="report-period-heading"><span class="eyebrow">ПЕРИОД ОТЧЁТА</span><h2>Выберите даты для аналитики</h2><p>Заявки, закупки и PDF-отчёт будут сформированы только за этот период.</p></div>
    <div class="report-period-controls">
        <label class="period-input"><span>Дата начала</span><input type="date" name="dateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" /></label>
        <span class="period-separator">—</span>
        <label class="period-input"><span>Дата окончания</span><input type="date" name="dateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" /></label>
        <button class="btn btn-primary" type="submit">Показать отчёт</button>
    </div>
</form>
<div class="report-kpis"><div class="report-kpi animate-in"><span class="kpi-label">Всего заявок</span><strong>@Model.TotalRequests</strong><span class="kpi-trend">за выбранный период</span></div><div class="report-kpi animate-in"><span class="kpi-label">Завершено</span><strong>@Model.CompletedRequests</strong><span class="kpi-trend positive">↑ @((Model.CompletedRequests * 100 / Math.Max(Model.TotalRequests, 1)))% от общего числа</span></div><div class="report-kpi animate-in"><span class="kpi-label">В работе</span><strong>@Model.InProgressRequests</strong><span class="kpi-trend warning">требуют контроля</span></div><div class="report-kpi animate-in"><span class="kpi-label">Закупки</span><strong>@Model.TotalSpend.ToString("N0") ₽</strong><span class="kpi-trend">за выбранный период</span></div></div>
<div class="dashboard-grid reports-grid"><section class="panel chart-panel animate-in"><div class="panel-heading"><div><span class="eyebrow">ЗАЯВКИ</span><h2>По статусам</h2></div><span class="chart-period">@periodText</span></div><div class="bar-chart">@if (Model.Statuses.Any()) { foreach (var item in Model.Statuses) { <div class="bar-item" data-tooltip="@item.Label: @item.Count заявок"><div class="bar-label"><span>@item.Label</span><strong>@item.Count</strong></div><div class="bar-track"><div class="bar-fill fill-@item.Label.Replace(" ", "-")" style="width:@(Math.Max(item.Count * 100 / maxStatus, 8))%"></div></div></div> } } else { <p class="empty-state">За выбранный период заявок нет.</p> }</div></section><section class="panel chart-panel animate-in"><div class="panel-heading"><div><span class="eyebrow">НАГРУЗКА</span><h2>По технике</h2></div></div><div class="bar-chart">@if (Model.EquipmentWorkload.Any()) { foreach (var item in Model.EquipmentWorkload) { <div class="bar-item" data-tooltip="@item.Label: @item.Count заявок"><div class="bar-label"><span>@item.Label</span><strong>@item.Count</strong></div><div class="bar-track"><div class="bar-fill fill-blue" style="width:@(Math.Max(item.Count * 100 / maxEquipment, 8))%"></div></div></div> } } else { <p class="empty-state">За выбранный период заявок нет.</p> }</div></section></div>
<section class="panel chart-panel wide-chart animate-in"><div class="panel-heading"><div><span class="eyebrow">ДИНАМИКА</span><h2>Регистрация заявок по дням</h2></div><span class="chart-period">@periodText</span></div><div class="bar-chart">@if (Model.Monthly.Any()) { foreach (var item in Model.Monthly) { <div class="bar-item" data-tooltip="@item.Label: @item.Count заявок"><div class="bar-label"><span>@item.Label</span><strong>@item.Count</strong></div><div class="bar-track"><div class="bar-fill fill-blue" style="width:@(Math.Max(item.Count * 100 / maxDaily, 8))%"></div></div></div> } } else { <p class="empty-state">За выбранный период заявок нет.</p> }</div></section>
